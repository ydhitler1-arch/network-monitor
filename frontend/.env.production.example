# Copy to .env.production for local production builds, OR set in Vercel dashboard.
# This tells the frontend where your Flask backend is running.
#
# Examples:
#   Local machine accessible on LAN:    VITE_API_BASE_URL=http://192.168.1.x:5000/api
#   Behind ngrok tunnel:                VITE_API_BASE_URL=https://xxxx.ngrok-free.app/api
#   Behind Cloudflare Tunnel:           VITE_API_BASE_URL=https://netmon.yourdomain.com/api
#
# Leave empty or unset to use the Vite dev proxy (local development only).
VITE_API_BASE_URL=
