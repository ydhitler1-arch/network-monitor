# Copy this file to `.env` and fill in real values before exposing the
# dashboard beyond localhost. Never commit the real `.env` file.

# Bind address. Use 127.0.0.1 for local-only access. Only widen this to
# 0.0.0.0 once auth is configured below AND you're running behind a
# TLS-terminating reverse proxy (see README > "Exposing to the internet").
NETMON_HOST=127.0.0.1
NETMON_PORT=5000

# Login credentials checked by POST /api/auth/login (session-cookie based).
# If NETMON_PASSWORD is left unset, a random one-time password is generated
# and printed to the console on each startup (fine for local testing, not
# for anything public).
NETMON_USERNAME=admin
NETMON_PASSWORD=change-me-to-a-long-random-value

# Signs the session cookie. If unset, a random key is generated on each
# startup, which logs everyone out on every restart. Set a stable value
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`) once
# this matters to you.
NETMON_SECRET_KEY=

# Only send the session cookie over HTTPS. Keep false for local http://
# testing; set true once running behind a TLS-terminating reverse proxy.
NETMON_COOKIE_SECURE=false

# Comma-separated list of origins allowed to call the API via CORS.
NETMON_CORS_ORIGINS=http://localhost:5173

# Rate limits applied to login attempts and the device-scan/port-scan endpoints.
NETMON_LOGIN_RATE_LIMIT=5 per minute
NETMON_SCAN_RATE_LIMIT=10 per minute
